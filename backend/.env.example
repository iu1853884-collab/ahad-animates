# ==========================================
# AHAD ANIMATES BACKEND ENVIRONMENT CONFIG
# ==========================================

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/ahad_animates
DB_USERNAME=postgres
DB_PASSWORD=

# Server Port
SERVER_PORT=8080

# JWT Security (Generate a secure 256-bit secret, e.g. openssl rand -base64 32)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_SECURE=false

# One-time Safe Initial Administrator Provisioning
# When backend starts and no admin exists, it will provision this initial administrator account.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=Ahad Admin

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CMS media storage (backend only; persistent local directory)
MEDIA_STORAGE_DIRECTORY=./data/media
MEDIA_MAX_FILE_SIZE=250MB
MEDIA_MAX_REQUEST_SIZE=251MB
