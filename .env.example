# ===================================================================
# AHAD ANIMATES — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env (or backend/.env) and .env.local for Next.js
# ===================================================================

# -------------------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js)
# -------------------------------------------------------------------
# Backend API public base URL
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_ASSISTANT_URL=http://localhost:8000

# -------------------------------------------------------------------
# BACKEND CONFIGURATION (Spring Boot)
# -------------------------------------------------------------------
# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/ahad_animates
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Security
# Generate a cryptographically strong 256-bit+ secret key
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_SECURE=false

# One-time Safe Initial Administrator Provisioning
# Used only when starting the backend if no administrator exists in PostgreSQL.
# Never hardcode production credentials in version control.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=Ahad Admin

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -------------------------------------------------------------------
# CONTACT EMAIL DELIVERY (Next.js server only; never use NEXT_PUBLIC_ here)
# -------------------------------------------------------------------
# Create a Resend account, verify a sending domain, then use an address on
# that verified domain as CONTACT_EMAIL_FROM. Supply the API key only in the
# server environment (for local development, .env.local).
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
# Optional receiving address; defaults to the public studio email.
CONTACT_EMAIL_TO=ahadanimates@gmail.com

# -------------------------------------------------------------------
# CMS MEDIA STORAGE (Spring Boot backend only)
# Persistent local directory; relative paths resolve from the backend working directory.
MEDIA_STORAGE_DIRECTORY=./data/media
MEDIA_MAX_FILE_SIZE=250MB
MEDIA_MAX_REQUEST_SIZE=251MB
