# Secrets — never upload
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Dependencies and build output
node_modules/
**/node_modules/
.next/
**/.next/
.next-old-*/
**/.next-old-*/
.vercel/
.git/

# Separate AI assistant and Python artifacts
ai-assistant/
**/.venv/
**/__pycache__/
**/.pytest_cache/

# Separate Java backend and build artifacts
backend/
**/target/

# Local logs and temporary files
*.log
npm-debug.log*
