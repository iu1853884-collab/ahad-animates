# Gemini credentials stay in this Python service and are never sent to the browser.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Only public published portfolio data is read from this endpoint.
PORTFOLIO_API_URL=http://localhost:8080/api/public/projects

# Comma-separated browser origins allowed to call this service.
FRONTEND_ORIGINS=http://localhost:3000

# Maximum assistant requests per client IP per minute.
RATE_LIMIT_PER_MINUTE=30


